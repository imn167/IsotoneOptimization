library(microbenchmark)
n <- 100
y <- rnorm(n)
w <- rep(1, n)
# Warm up (first call might be slower due to compilation)
solve_isotone_chain(y, w)
# Benchmark
result <- microbenchmark(
solve_isotone_chain(y, w),
times = 100
)
print(result)
